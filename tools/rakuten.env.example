# このファイルをコピーして rakuten.env という名前で保存し、値を書き換える。
# 値は楽天ウェブサービス（https://webservice.rakuten.co.jp/）でアプリ登録すると発行される。
# rakuten.env は他人に渡さないこと。

# アプリケーションID（UUID 形式。例: 2e7dccdc-xxxx-xxxx-xxxx-xxxxxxxxxxxx）
RAKUTEN_APP_ID=
# アクセスキー（pk_ で始まる）
RAKUTEN_ACCESS_KEY=

# アプリケーションタイプを「Webアプリケーション」で登録した場合だけ書く。
# 「許可されたWebサイト」に登録したサイトの URL（https:// から）。
# 「API/バックエンドサービス」で登録した場合は空のままでよい。
RAKUTEN_REFERER=
